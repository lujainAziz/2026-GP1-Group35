# ASSAS demo / self-test rules: one rule per severity level (priority 1-3 ->
# High, Medium, Low in the alert ingester; 3 or more, or missing, is Low).
# Deployed to /etc/suricata/assas-test.rules; suricata-update merges it into
# /var/lib/suricata/rules/suricata.rules via the local: entry in update.yaml,
# so these rules persist across rule updates.
#
# Each rule fires only on an HTTP request to /assas-test/<level> on the
# appliance (sent from a device on the mirrored network). The request is
# harmless: the server answers 404. SIDs 1000001-1000003 are in the local
# range and do not clash with ET Open. SID 1000004 (the old priority-4 Low
# rule) is retired; do not reuse it.

alert http any any -> any any (msg:"ASSAS TEST High"; flow:to_server,established; http.uri; content:"/assas-test/high"; priority:1; sid:1000001; rev:2;)
alert http any any -> any any (msg:"ASSAS TEST Medium"; flow:to_server,established; http.uri; content:"/assas-test/medium"; priority:2; sid:1000002; rev:2;)
alert http any any -> any any (msg:"ASSAS TEST Low"; flow:to_server,established; http.uri; content:"/assas-test/low"; priority:3; sid:1000003; rev:2;)
