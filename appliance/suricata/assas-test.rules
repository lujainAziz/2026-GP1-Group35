# ASSAS demo / self-test rules: one rule per severity level (priority 1-4 ->
# Critical, High, Medium, Low in the alert ingester).
# Deployed to /etc/suricata/assas-test.rules; suricata-update merges it into
# /var/lib/suricata/rules/suricata.rules via the local: entry in update.yaml,
# so these rules persist across rule updates.
#
# Each rule fires only on an HTTP request to /assas-test/<level> on the
# appliance (sent from a device on the mirrored network). The request is
# harmless: the server answers 404. SIDs 1000001-1000004 are in the local
# range and do not clash with ET Open.

alert http any any -> any any (msg:"ASSAS TEST Critical"; flow:to_server,established; http.uri; content:"/assas-test/critical"; priority:1; sid:1000001; rev:1;)
alert http any any -> any any (msg:"ASSAS TEST High"; flow:to_server,established; http.uri; content:"/assas-test/high"; priority:2; sid:1000002; rev:1;)
alert http any any -> any any (msg:"ASSAS TEST Medium"; flow:to_server,established; http.uri; content:"/assas-test/medium"; priority:3; sid:1000003; rev:1;)
alert http any any -> any any (msg:"ASSAS TEST Low"; flow:to_server,established; http.uri; content:"/assas-test/low"; priority:4; sid:1000004; rev:1;)
