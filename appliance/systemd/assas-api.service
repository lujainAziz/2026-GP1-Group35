[Unit]
Description=ASSAS Read-Only Device Inventory API
Wants=network-online.target
After=network-online.target assas-discovery.service

[Service]
Type=simple
User=assas
WorkingDirectory=/home/assas/assas/appliance
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/assas/assas/.venv/bin/uvicorn api:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
